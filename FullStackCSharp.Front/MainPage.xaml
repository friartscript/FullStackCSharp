<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FullStackCSharp.Front.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
            <Label
                Text="FullStackCSharp"
                FontSize="32"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <Label
                Text="Gelato Artisan"
                FontSize="18"
                TextColor="#6C5CE7"
                HorizontalOptions="Center" />

            <Label
                Text="Boutique Artisanale de Glaces"
                Style="{StaticResource Headline}"
                HorizontalOptions="Center"
                SemanticProperties.HeadingLevel="Level1" />

            <Label
                Text="Découvrez nos parfums d'exception et composez votre coupe personnalisée."
                Style="{StaticResource SubHeadline}"
                HorizontalOptions="Center"
                SemanticProperties.HeadingLevel="Level2" />

            <Button
                x:Name="CounterBtn"
                Text="Tester la réactivité locale" 
                SemanticProperties.Hint="Valide le bon fonctionnement du moteur XAML"
                Clicked="OnCounterClicked"
                HorizontalOptions="Center"
                WidthRequest="260" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
